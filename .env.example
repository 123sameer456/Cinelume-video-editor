# Cinelume server settings. Copy to .env and adjust.
# All values have safe defaults; only set what you need to change.

# Where uploads, work dirs, outputs, models and the job DB live.
# DATA_DIR=./data

# Paths to the media tools (must be a full FFmpeg build with libass).
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe

# Global limits
# MAX_UPLOAD_GB=10
# MAX_DURATION_MIN=180
# MAX_CONCURRENT_JOBS=1
# UPLOAD_TTL_HOURS=24
# WORK_TTL_HOURS=24

# Server
# HOST=127.0.0.1
# PORT=8000

# Set a token only if you deliberately expose the server to other machines.
# ACCESS_TOKEN=
